# Optional: live readings. Without a key the app runs on the local preview engine.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# openai | openrouter
LLM_PROVIDER=openai

# Optional model overrides
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_MODEL=openrouter/free

# Optional OpenRouter attribution
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=ShapeLLM
